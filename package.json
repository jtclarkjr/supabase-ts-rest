{
  "name": "@jtclarkjr/supabase-ts-rest",
  "version": "0.2.6",
  "description": "A lightweight TypeScript client for Supabase REST API with authentication support",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsgo",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "oxlint src/**/*.ts",
    "lint:fix": "oxlint src/**/*.ts --fix",
    "fmt": "oxfmt --write .",
    "prepublishOnly": "bun run build",
    "dev": "tsgo --watch",
    "typecheck": "tsgo --noEmit"
  },
  "keywords": [
    "supabase",
    "rest",
    "api",
    "client",
    "typescript",
    "authentication",
    "database"
  ],
  "author": "jtclarkjr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtclarkjr/supabase-ts-rest.git",
    "directory": "npm"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@typescript/native-preview": "latest",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.11.2"
  },
  "dependencies": {},
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
