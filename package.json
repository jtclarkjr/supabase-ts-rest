{
  "name": "@jtclarkjr/supabase-ts-rest",
  "version": "0.2.7",
  "description": "A lightweight TypeScript client for Supabase REST API with authentication support",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:watch": "vp test watch",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt . --write",
    "check": "vp check --fix"
  },
  "keywords": [
    "supabase",
    "rest",
    "api",
    "client",
    "typescript",
    "authentication",
    "database"
  ],
  "author": "jtclarkjr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtclarkjr/supabase-ts-rest.git",
    "directory": "npm"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "vite-plus": "^0.2.8"
  },
  "dependencies": {}
}
